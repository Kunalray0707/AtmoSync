# Environment Configuration Example
ENV=development
DEBUG=True
SECRET_KEY=atmosync_super_secret_jwt_key_change_in_production_2026

# Database
POSTGRES_USER=atmosync
POSTGRES_PASSWORD=atmosync_pass
POSTGRES_DB=atmosync_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://atmosync:atmosync_pass@localhost:5432/atmosync_db

# Redis Caching
REDIS_HOST=localhost
REDIS_PORT=6379

# Kafka Broker
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_TELEMETRY=atmosync.container.telemetry
KAFKA_TOPIC_ALERTS=atmosync.container.alerts
KAFKA_TOPIC_DLQ=atmosync.container.dlq

# Snowflake Credentials
SNOWFLAKE_ACCOUNT=xy12345.us-east-1
SNOWFLAKE_USER=ATMOSYNC_USER
SNOWFLAKE_PASSWORD=AtmoSyncSecurePass2026!
SNOWFLAKE_DATABASE=ATMOSYNC_DB
SNOWFLAKE_SCHEMA=ANALYTICS
SNOWFLAKE_WAREHOUSE=ATMOSYNC_WH
SNOWFLAKE_ROLE=ATMOSYNC_ANALYST

# Mapbox Token (Optional for frontend maps)
