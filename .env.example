# PostgreSQL
DATABASE_URL=postgresql+asyncpg://USER:CHANGE_ME@localhost:5432/atmosync
DATABASE_URL_SYNC=postgresql://USER:CHANGE_ME@localhost:5432/atmosync

# JWT Authentication
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis
REDIS_URL=redis://localhost:6379/0

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_IOT_SENSOR=iot_sensor_data
KAFKA_TOPIC_COMMODITY_PRICE=commodity_prices
KAFKA_CONSUMER_GROUP=atmosync_consumer_group

# Snowflake
SNOWFLAKE_ACCOUNT=your_account
SNOWFLAKE_USER=your_user
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_WAREHOUSE=ATMOSYNC_WH
SNOWFLAKE_DATABASE=ATMOSYNC_DB
SNOWFLAKE_SCHEMA=ANALYTICS

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Streamlit
ATMOSYNC_BACKEND_URL=http://127.0.0.1:8000/api/v1
ATMOSYNC_REQUEST_TIMEOUT=8

# Optional integrations
SLACK_WEBHOOK_URL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL=admin@atmosync.com

